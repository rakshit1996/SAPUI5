
<mvc:View
	controllerName="ui5.walkthrough.controller.HelloPanel"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	displayBlock="true">        
	<Panel
			headerText="{i18n>helloPanelTitle}"
             class="sapUiResponsiveMargin"
            width = "auto">
				<content>
							<Button
                                text= "{i18n>showHelloButtonText}"
                                press= ".onShowHello"
                                tooltip = "{i18n>pressbuttontoolTip}"
                                icon= "sap-icon://touch"
                                class="myCustomButton"
                                />
                            <Text 
                                text ="Today'S Date is : {/recepient/dateinfo}"
                                showClearIcon = "true" 
                                placeholder = "Date "
                                tooltip = "{i18n>Name}"
                                width="60%"
                                class="sapUiSmallMargin sapThemeHighlight-asColor myCustomText"/>
                    
                            <Button text   = "{i18n>getDate}"
                                press  = ".onGetDate"
                                icon  = "sap-icon://accelerated"
                                class="myCustomButton"/>
                                <!-- This is the buttpn for dialog box which open seperately via an dialog fragments -->
                            <Button     id="helloDialogButton"
                                        text="Dialog Box"
                                        tooltip="{i18n>markAsRead}"
                                        press=".onMarkAsRead"
                                        icon="sap-icon://bell"
                            />
                            <Input 
                                value ="{/recepient/name}"
                                description = "Name: {/recepient/name}"
                                valueLiveUpdate="true"
                                showClearIcon = "true" 
                                placeholder = "Enter your Name "
                                tooltip = "{i18n>Name}"
                                width="60%"
                               class="myCustomButton sapThemeHighlight-asColor myCustomText"/>
                            <!-- <Input 
                                value ="{/recepient/age}"
                                description = "Age: {/recepient/age}"
                                valueLiveUpdate="false"
                                showClearIcon = "true" 
                                placeholder = "Enter your Age "
                                tooltip = "{i18n>Name}"
                                width="60%"
                                class="myCustomButton sapThemeHighlight-asColor myCustomText"/>   -->
			</content>
	</Panel>

</mvc:View>

